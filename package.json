{
  "name": "ycagentphone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test test/agentphone.test.ts test/server.test.ts test/post-call.test.ts test/reservation-log.test.ts test/reservations.test.ts test/memory.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "configure:webhook": "bun scripts/configure-agentphone-webhook.ts",
    "configure:stripe": "bun scripts/configure-stripe-test.ts",
    "send:activation-sms": "bun scripts/send-agentphone-activation-sms.ts",
    "ingest:kb": "bun scripts/ingest-kb.ts",
    "test:webhook": "bun scripts/test-webhook.ts",
    "test:turn": "bun scripts/test-turn.ts"
  },
  "dependencies": {
    "@langfuse/openai": "^5.3.0",
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@moss-dev/moss": "^1.0.2",
    "@opentelemetry/sdk-node": "^0.203.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.104.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "bun-types": "^1.3.1",
    "supertest": "^7.0.0",
    "typescript": "^5.8.2"
  }
}
