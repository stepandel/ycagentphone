OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Moss knowledgebase retrieval.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=ycagentphone-restaurant-kb
MOSS_SEARCH_LIMIT=8
MOSS_SEARCH_ALPHA=0.8
MOSS_AUTO_REFRESH=true
MOSS_AUTO_REFRESH_INTERVAL_SECONDS=300
MOSS_CACHE_PATH=
MOSS_MODEL_ID=moss-minilm

# Optional, but recommended when AgentPhone provides a signing secret.
AGENTPHONE_WEBHOOK_SECRET=
AGENTPHONE_API_KEY=
AGENTPHONE_BASE_URL=https://api.agentphone.ai
AGENTPHONE_AGENT_ID=
AGENTPHONE_WEBHOOK_BASE_URL=https://your-static-domain.ngrok-free.app

# Stripe test reservation deposit payment link.
STRIPE_SECRET_KEY=
STRIPE_RESERVATION_DEPOSIT_AMOUNT_CENTS=10000
STRIPE_RESERVATION_DEPOSIT_CURRENCY=usd
STRIPE_RESERVATION_PAYMENT_LINK_URL=

# Restaurant customization.
COMPANY_NAME=Your Restaurant
RESTAURANT_GREETING="Good evening, and thank you for calling. This is the restaurant's virtual host. How may I help you today?"
RESTAURANT_PROCESSING_MESSAGE="Of course. Let me check that for you."
PUBLIC_CONTACT_EMAIL=events@example.com

# Server config.
PORT=3000
HOST=::
LOG_LEVEL=info
