OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Create this with: npm run ingest:kb
OPENAI_VECTOR_STORE_ID=

# Optional, but recommended when AgentPhone provides a signing secret.
AGENTPHONE_WEBHOOK_SECRET=

# Agent/company customization.
COMPANY_NAME=Your Company
PUBLIC_CONTACT_EMAIL=sales@example.com

# Server config.
PORT=3000
LOG_LEVEL=info
