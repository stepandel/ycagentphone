OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supermemory knowledgebase retrieval.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=ycagentphone-kb
