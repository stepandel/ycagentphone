OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Supermemory knowledgebase retrieval.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=ycagentphone-restaurant-kb
SUPERMEMORY_SEARCH_LIMIT=8
SUPERMEMORY_SEARCH_MODE=hybrid

# Optional, but recommended when AgentPhone provides a signing secret.
AGENTPHONE_WEBHOOK_SECRET=
AGENTPHONE_API_KEY=
AGENTPHONE_BASE_URL=https://api.agentphone.ai
AGENTPHONE_AGENT_ID=
AGENTPHONE_WEBHOOK_BASE_URL=https://your-static-domain.ngrok-free.app

# Restaurant customization.
COMPANY_NAME=Your Restaurant
RESTAURANT_GREETING="Good evening, and thank you for calling. This is the restaurant's virtual host. How may I help you today?"
RESTAURANT_PROCESSING_MESSAGE="Of course. Let me check that for you."
PUBLIC_CONTACT_EMAIL=events@example.com

# Server config.
PORT=3000
HOST=::
LOG_LEVEL=info
